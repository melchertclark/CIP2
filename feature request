from docx import Document
from datetime import date
import os

# === config ===
template_path = "base_template.docx"  # your starting Word file
school_names_path = "schools.txt"     # file with one school name per line
output_dir = "output_docs"            # folder to save new files

# === make sure output dir exists ===
os.makedirs(output_dir, exist_ok=True)

# === read school names ===
with open(school_names_path, "r", encoding="utf-8") as f:
    school_names = [line.strip() for line in f if line.strip()]

# === get today’s date ===
today_str = date.today().isoformat()

# === load template once ===
template = Document(template_path)

# === generate docs ===
for school in school_names:
    filename = f"{school} Variation List {today_str}.docx"
    filepath = os.path.join(output_dir, filename)

    # make a copy of the template content
    new_doc = Document()
    for element in template.element.body:
        new_doc.element.body.append(element)

    new_doc.save(filepath)
    print(f"Created: {filename}")
