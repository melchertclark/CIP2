{
  "name": "cip2",
  "version": "0.1.0",
  "description": "CIP2 Electron application for managing FoI and Program JSON data",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack --config webpack.config.js && electron .",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "start": "electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "gsap": "^3.12.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-redux": "^8.1.3",
    "redux-undo": "^1.1.0"
  },
  "devDependencies": {
    "@types/react-dom": "^18.3.6",
    "cross-env": "^7.0.3",
    "css-loader": "^6.5.1",
    "electron": "^25.0.0",
    "electron-builder": "^23.6.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^4.10.0"
  },
  "build": {
    "appId": "com.example.cip2",
    "mac": {
      "target": [
        "dmg"
      ],
      "arch": [
        "arm64",
        "x64"
      ]
    }
  }
}
